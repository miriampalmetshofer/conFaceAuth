{
  "pool": "controlled_study",
  "devices": [
    "desktop",
    "mobile"
  ],
  "paths": {
    "base_path": "data/controlled_study",
    "enrollment_base_path": "data/enrollments",
    "results_dir": "{base_path}/results"
  },
  "models": {
    "detector": "mediapipe",
    "embedder": {
      "type": "insightface",
      "model_name": "buffalo_sc",
      "det_size": [
        640,
        640
      ],
      "min_detection_confidence": 0.6
    }
  },
  "run": {
    "num_workers": 4
  },
  "authentication": {
    "backend": {
      "type": "temporal_decay",
      "threshold": 0.5,
      "similarity_percentile": 0.9,
      "k_weight": 45000,
      "k_decay": 60000,
      "initial_confidence": 1
    },
    "authentication_hz": 1.0
  },
  "enrollment": {
    "enrollment_video_preference": {
      "scenarios": [
        "easy"
      ],
      "rotations": [
        "cw",
        "ccw"
      ]
    },
    "force_reenrollment": true,
    "backend": {
      "type": "fixed_order",
      "window_seconds": 2.0
    },
    "frames_per_direction": 5
  },
  "imposter_creation": {
    "genuine_user_seconds": 180,
    "black_screen_seconds": 3,
    "impostor_seconds": 180,
    "matching_strategy": {
      "type": "scenario"
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  },
